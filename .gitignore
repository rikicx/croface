# Sistema
.DS_Store

# Ferramentas locais (não fazem parte do site)
.claude/
.impeccable/

# Material de trabalho (fotos brutas otimizadas; não faz parte do site)
_fotos-web/

# Imagens geradas: originais PNG pesados e versão v1 não usada no site (ficam só no computador)
_entrega/imagens-ia/**/originais/
_entrega/imagens-ia/originais/
assets/img/ia/*.jpg
assets/img/ia/*.webp

# Cópia autocontida gerada por _entrega/gerar-copia-html.py (arquivos grandes; gerar de novo quando precisar)
_entrega/copia-html/
_entrega/croface-copia-html.zip

# Pacote para o servidor gerado por _entrega/gerar-pacote-servidor.py (gerar de novo quando mudar o site)
_entrega/croface-site.zip
